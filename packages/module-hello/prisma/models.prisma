model Hello_Greeting {
  id        String   @db.Uuid
  tenantId  String   // Better-Auth Organization id: plain string, never @db.Uuid (CLAUDE.md §9)
  userId    String   // Better-Auth User id: plain string, never @db.Uuid (CLAUDE.md §9)
  message   String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@id([id, tenantId])
  @@index([tenantId, userId, createdAt])
}
