    "zod": "^3.24.1",
    "react": "^19.0.0",
    "@quetzal/core": "workspace:*",
    "@quetzal/db": "workspace:*",
    "@quetzal/ui": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@quetzal/config": "workspace:*",
    "@types/react": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
