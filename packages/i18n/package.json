{
  "name": "@quetzal/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./catalogues/*": "./catalogues/*"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('catalogues', 'dist/catalogues', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "merge": "tsx src/merge.ts"
  },
  "dependencies": {
    "next-intl": "^3.26.3"
  },
  "devDependencies": {
    "@quetzal/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
