{
  "name": "@quetzal/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./config": "./dist/config.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node --env-file-if-exists=../../.env.local --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "nanostores": "^1.5.2",
    "@quetzal/db": "workspace:*"
  },
  "devDependencies": {
    "@quetzal/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@quetzal/core": "workspace:*",
    "auth": "^1.7.2"
  }
}
